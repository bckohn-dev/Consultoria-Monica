# Local API: npm run dev:vercel. Never set VERCEL_ENV=production locally.
FIREBASE_ADMIN_PROJECT_ID=catalogo-imoveis-dev
FIREBASE_EXPECTED_PROJECT_ID=catalogo-imoveis-dev
FIREBASE_ADMIN_CLIENT_EMAIL=
# Private key is server-only. Never prefix this variable with VITE_.
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_STORAGE_ENABLED=false
CATALOG_SEED_SNAPSHOT=true
ADMIN_EMAILS=
# Public client JSON: use the contents of config/firebase-dev.public.json as one line.
VITE_FIREBASE_CONFIG=
